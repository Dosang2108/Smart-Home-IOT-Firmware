{
  "database": "gateway_buffer.db",
  "flush_interval_seconds": 2.0,
  "publish_timeout_seconds": 5.0,
  "batch_size": 100,
  "state_policy": "latest",
  "local": {
    "host": "127.0.0.1",
    "port": 1883,
    "client_id": "yolohome-gateway-local",
    "username": "",
    "password": "",
    "tls": false,
    "insecure_tls": false
  },
  "cloud": {
    "host": "YOUR_CLUSTER.s1.eu.hivemq.cloud",
    "port": 8883,
    "client_id": "yolohome-gateway-cloud",
    "username": "YOUR_HIVEMQ_USERNAME",
    "password": "YOUR_HIVEMQ_PASSWORD",
    "tls": true,
    "insecure_tls": false
  },
  "uplink_topics": [
    "yolohome/device/yolo_uno_01/ack",
    "yolohome/device/yolo_uno_01/state",
    "yolohome/device/yolo_uno_01/telemetry",
    "yolohome/device/yolo_uno_01/event",
    "yolohome/device/yolo_uno_01/availability"
  ],
  "downlink_topics": [
    "yolohome/device/yolo_uno_01/cmd"
  ]
}
